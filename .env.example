# Ofrenda configuration.
#
#   cp .env.example .env      then edit .env   (.env is gitignored; never commit it)
#   npm run doctor            checks every value below and tells you what works
#
# Only Ollama is REQUIRED. Every key in the "optional" sections can stay blank
# and the app still runs, fully local.

# ============================================================================
# REQUIRED: the model (runs on your machine, no account, no key)
# ============================================================================
# Install Ollama from https://ollama.com, then:  ollama pull gemma3:4b
OLLAMA_BASE_URL=http://127.0.0.1:11434
# gemma3:4b = better answers, needs ~4 GB free RAM. gemma3:1b = much faster, less accurate.
OFRENDA_MODEL=gemma3:4b

# ============================================================================
# SERVER
# ============================================================================
PORT=3000
# Keep on loopback (only this computer can reach it). Use 0.0.0.0 ONLY when deployed, and set OFRENDA_PIN.
HOST=127.0.0.1
# Where altar.json lives. Render uses /var/data (a persistent disk).
OFRENDA_DATA_DIR=./data
# A shared "word" that locks the whole app. Leave blank on your laptop.
# On Render this is generated for you. To make one:  openssl rand -base64 18
OFRENDA_PIN=

# ============================================================================
# OPTIONAL: ElevenLabs  (voice: reads replies aloud + turns a recording into a memory)
# Get it:  elevenlabs.io -> sign in -> Developers / profile -> API Keys -> Create key
# Needs permissions: Text to Speech + Speech to Text.
# This is the ONLY thing that sends any text off your machine, and only if you set it.
# ============================================================================
ELEVENLABS_API_KEY=
# Default is the "George" premade voice. Browse voices in the ElevenLabs Voice Library and paste any voice ID.
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb

# ============================================================================
# OPTIONAL: MongoDB Atlas  (store altars in the cloud instead of data/altar.json)
# Get it:  cloud.mongodb.com -> create a free M0 cluster -> Database Access: add a user
#          -> Network Access: add your IP (or 0.0.0.0/0 for Render) -> Connect -> Drivers -> copy the URI
# Replace <password> with the user's password. URL-encode special characters.
# ============================================================================
MONGODB_URI=
MONGODB_DB=ofrenda

# ============================================================================
# OPTIONAL: Sentry  (traces how fast the ghost is; never sends your stories)
# Get it:  sentry.io -> create a project (platform: Node.js) -> Settings -> Client Keys (DSN)
# ============================================================================
SENTRY_DSN=
