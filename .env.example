# --- Core (everything works with just Ollama running) ---------------------
PORT=3000
HOST=127.0.0.1                       # keep on loopback unless you set OFRENDA_PIN
OLLAMA_BASE_URL=http://127.0.0.1:11434
OFRENDA_MODEL=gemma3:4b              # any Ollama model: gemma3:1b, gemma3:4b, llama3.2, qwen3 ...
OFRENDA_DATA_DIR=./data

# --- Optional: protect a deployed instance --------------------------------
OFRENDA_PIN=

# --- Optional partner integrations (leave blank to stay 100% local) -------
MONGODB_URI=                         # MongoDB Atlas: store altars in Atlas instead of data/altar.json
MONGODB_DB=ofrenda
SENTRY_DSN=                          # Sentry agent tracing (latency / tokens only, never message text)
ELEVENLABS_API_KEY=                  # narration (TTS) + oral-history transcription (Scribe)
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
